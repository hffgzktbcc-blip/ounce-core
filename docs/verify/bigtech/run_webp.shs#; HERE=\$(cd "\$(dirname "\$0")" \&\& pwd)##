#!/bin/bash
# Set BT (work dir holding the upstream checkouts and this directory copied to $BT/h) and ZIG (Zig 0.17.1 binary).
BT=${BT:-/tmp/bigtech-verify}; ZIG=${ZIG:-/tmp/zig/zig}; HERE=$(cd "$(dirname "$0")" && pwd)
W=$BT/libwebp; cd $BT/h
SRC=$(ls $W/src/dec/*.c $W/src/dsp/*.c $W/src/enc/*.c $W/src/utils/*.c $W/sharpyuv/*.c | grep -v -E "_sse|_avx|_mips|_msa|_wasm")
D=(-I$W -I$W/src -w)
clang -O2 "${D[@]}" webp_drv.c $SRC -lm -o webp_native 2>&1 | grep -E "error|undefined" | head -5
"$ZIG" cc -target aarch64-linux-musl -static -no-pie -O2 "${D[@]}" webp_drv.c $SRC -lm -o webp_O2 2>&1 | grep -E "error|undefined" | head -5
"$ZIG" cc -target aarch64-linux-musl -static -no-pie -O3 -mcpu=apple_m1 "${D[@]}" webp_drv.c $SRC -lm -o webp_O3 2>&1 | grep -E "error|undefined" | head -5
ls -la webp_native webp_O2 webp_O3; ./webp_native > webp.ref; tail -2 webp.ref
