#!/bin/bash
# Set BT (work dir holding the upstream checkouts and this directory copied to $BT/h) and ZIG (Zig 0.17.1 binary).
BT=${BT:-/tmp/bigtech-verify}; ZIG=${ZIG:-/tmp/zig/zig}; HERE=$(cd "$(dirname "$0")" && pwd)
S=$BT/secp256k1
D=(-DSECP256K1_BUILD -DENABLE_MODULE_ECDH=1 -DENABLE_MODULE_RECOVERY=1 -DENABLE_MODULE_EXTRAKEYS=1 -DENABLE_MODULE_SCHNORRSIG=1 -DENABLE_MODULE_MUSIG=1 -DENABLE_MODULE_ELLSWIFT=1 -DENABLE_MODULE_SILENTPAYMENTS=1 -DECMULT_WINDOW_SIZE=15 -DCOMB_BLOCKS=43 -DCOMB_TEETH=6 -DVERIFY -I$S -I$S/src -I$S/include)
cd $BT/h
clang -O2 "${D[@]}" $S/src/tests.c $S/src/precomputed_ecmult.c $S/src/precomputed_ecmult_gen.c -o secp_native 2>&1 | grep -E "error" | head
"$ZIG" cc -target aarch64-linux-musl -static -no-pie -O2 "${D[@]}" $S/src/tests.c $S/src/precomputed_ecmult.c $S/src/precomputed_ecmult_gen.c -o secp_O2 2>&1 | grep -E "error" | head
"$ZIG" cc -target aarch64-linux-musl -static -no-pie -O3 -mcpu=apple_m1 "${D[@]}" $S/src/tests.c $S/src/precomputed_ecmult.c $S/src/precomputed_ecmult_gen.c -o secp_O3 2>&1 | grep -E "error" | head
ls -la secp_*
